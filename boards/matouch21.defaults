# Board selection for 'matouch21'.
#
# Everything else board-specific (element order, mirroring, pin map,
# transmit power) comes from the Kconfig defaults keyed off this symbol, so
# this file stays a one-line board pick and the verified values live in one
# place -- and a plain `idf.py build`, which never reads this file, gets the
# same firmware.
CONFIG_CAPSTAN_BOARD_MATOUCH_21=y
